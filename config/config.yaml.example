# =============================================================================
# AI Agent Local Infrastructure — Config Template
# =============================================================================
# Copy this file to config.yaml and fill in your own values.
# Never commit real credentials to version control.
# =============================================================================

model:
  context_length: 1048576
  default: deepseek-v4-flash
  provider: deepseek

providers:
  # Add your API providers here
  # openrouter:
  #   api_key: "sk-xxx"

agent:
  max_turns: 60
  gateway_timeout: 1800
  api_max_retries: 3
  image_input_mode: auto
  verbose: false

terminal:
  backend: local
  timeout: 180

memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 4400
  user_char_limit: 2750

delegation:
  max_concurrent_children: 3
  orchestrator_enabled: true

auxiliary:
  vision:
    provider: custom
    model: Qwen2.5-VL-7B-4bit
    base_url: http://localhost:8800/v1
    timeout: 120

platforms:
  dingtalk:
    extra:
      client_id: "YOUR_DINGTALK_CLIENT_ID"
      client_secret: "YOUR_DINGTALK_CLIENT_SECRET"
  telegram:
    extra:
      disable_link_previews: false

cron:
  wrap_response: true

skills:
  external_dirs: []
  template_vars: true
  guard_agent_created: false
